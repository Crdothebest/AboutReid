MODEL:
  MOE_RESIDUAL_WEIGHT: 0.85
  MOE_EXPERT_THRESHOLD: 0.1
  MOE_GATE_DROPOUT: 0.1
  MOE_EXPERT_DROPOUT: 0.1
  MOE_GATE_LAYERS: 2
  MOE_EXPERT_LAYERS: 2
  MOE_TEMPERATURE: 0.8
  MOE_EXPERT_HIDDEN_DIM: 1024
  MOE_SCALES: [4,8,16]
  USE_MULTI_SCALE_MOE: True
  CLIP_MULTI_SCALE_SCALES: [4,8,16]
  USE_CLIP_MULTI_SCALE: True
  PRETRAIN_PATH_T: '/home/zubuntu/workspace/yzy/MambaPro/pths/ViT-B-16.pt'
  # Transformer backbone 的预训练权重（.pth）的位置
  
  TRANSFORMER_TYPE: 't2t_vit_t_24'  # 修改为T2T-ViT-24模型
  STRIDE_SIZE: [ 16, 16 ]
  SIE_CAMERA: True
  DIRECT: 0
  SIE_COE: 1.0
  ID_LOSS_WEIGHT: 0.25
  TRIPLET_LOSS_WEIGHT: 1.0
  PROMPT: True
  ADAPTER: True
  MAMBA: True
  FROZEN: True
  
  # 新增：多尺度滑动窗口配置
  USE_MULTI_SCALE: True  # 启用多尺度滑动窗口特征提取
  MULTI_SCALE_SCALES: [4, 8, 16]  # 滑动窗口尺度配置
  

INPUT:
  SIZE_TRAIN: [ 128, 256 ]
  SIZE_TEST: [ 128, 256 ]
  PROB: 0.5 # random horizontal flip
  RE_PROB: 0.5 # random erasing
  PADDING: 10

DATALOADER:
  SAMPLER: 'softmax_triplet'
  NUM_INSTANCE: 4
  NUM_WORKERS: 8 # or 14

DATASETS:
# 所需要使用的数据集名称
  NAMES: ('MSVR310')
  ROOT_DIR: '/home/zubuntu/workspace/yzy/MambaPro/data/'

SOLVER:
  BASE_LR: 0.00035
  WARMUP_ITERS: 10
  MAX_EPOCHS: 60
  OPTIMIZER_NAME: 'Adam'
  STEPS: [ 30, 50 ]
  GAMMA: 0.1
  IMS_PER_BATCH: 32

TEST:
# 指定测试/推理阶段要加载的模型权重（通常是你训练好的最佳模型）。
  IMS_PER_BATCH: 32
  RE_RANKING: 'no'
  WEIGHT: '/home/zubuntu/workspace/yzy/MambaPro/pths/MambaProbest.pth'
  NECK_FEAT: 'before'
  FEAT_NORM: 'yes'
  MISS: "nothing"
# 作用：训练过程生成的模型权重、日志文件会保存到这个文件夹
OUTPUT_DIR: 'results/everyExperiments/experiment_20251022_175112/logs'


